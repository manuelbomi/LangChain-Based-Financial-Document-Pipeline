# Copy to .env and adjust as needed. All values below are defaults --
# the toolkit runs fully offline with zero configuration.
#
# Every variable is prefixed TOOLKIT_ and maps to a field on
# toolkit.config.Settings (see that file for full documentation).

# --- General ---------------------------------------------------------
TOOLKIT_ENVIRONMENT=local
TOOLKIT_LOG_LEVEL=INFO
# "json" for machine-parseable structured logs, "console" for local dev readability
TOOLKIT_LOG_FORMAT=json

# --- Data locations (defaults resolve relative to the repo root) -----
# TOOLKIT_SAMPLE_UNSTRUCTURED_DIR=./data/sample_unstructured
# TOOLKIT_SAMPLE_DB_PATH=./data/sample_bank.db
# TOOLKIT_STATE_DIR=./data/state

# --- Chunking ----------------------------------------------------------
TOOLKIT_CHUNK_SIZE=400
TOOLKIT_CHUNK_OVERLAP=50

# --- Indexing / governance ---------------------------------------------
TOOLKIT_FRESHNESS_SLA_HOURS=24
TOOLKIT_DEFAULT_RETENTION_TAG=standard-7y

# No API keys are required to run this toolkit's default demo. If you wire
# in a real embeddings provider (see toolkit/chunking/semantic.py) or a real
# vector store, add its credentials here -- never commit a populated .env.
